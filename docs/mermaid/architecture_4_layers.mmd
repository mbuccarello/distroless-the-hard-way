    classDef special fill:#1f6feb,stroke:#58a6ff,stroke-width:2px,color:#ffffff
    classDef build fill:#238636,stroke:#2ea043,stroke-width:2px,color:#ffffff

    subgraph "Ephemeral Builder (L0)"
