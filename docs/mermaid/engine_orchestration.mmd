graph TD
    classDef default fill:#1f2428,stroke:#444c56,stroke-width:2px,color:#c9d1d9
    classDef script fill:#1f6feb,stroke:#58a6ff,stroke-width:2px,color:#ffffff
    classDef file fill:#8b949e,stroke:#444c56,stroke-width:1px,color:#ffffff
    classDef output fill:#238636,stroke:#2ea043,stroke-width:2px,color:#ffffff

    subgraph "Inputs"
        Arch[Arch Linux PKGBUILDs]:::file
        YML[stacks/*.yaml]:::file
    end

    Engine(engine/engine.py):::script

    Arch --> Engine
    YML --> Engine

    subgraph "Outputs"
        HCL[Docker Bake HCL]:::output
        DF[Dynamic Dockerfiles]:::output
    end

    Engine -- "--mode foundation" --> HCL
    Engine -- "--mode runtime" --> DF

    HCL --> Build((Docker Buildx Bake))
    DF --> Build
